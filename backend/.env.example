# MariaDB running via docker-compose (root docker-compose.yml). Values must
# match MARIADB_USER/MARIADB_PASSWORD/MARIADB_DATABASE in the root .env.
# Backend runs on the host, so it reaches the DB via the published port.
DATABASE_URL="mysql://<MARIADB_USER>:<MARIADB_PASSWORD>@localhost:3306/<MARIADB_DATABASE>"

JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="30d"

# Google Cloud Console -> OAuth 2.0 Client (Web application). Only the
# client ID is needed server-side (ID token audience check) — see
# Afaireplustard.txt.
GOOGLE_CLIENT_ID=""

# Host-mode frontend dev server (frontend/vite.config.ts, strictPort 5173).
# Used for CORS and for building the password-reset link.
FRONTEND_URL="http://localhost:5173"

# Enables /user/me/dev-has-paid. Local dev only: never set this in
# production. The route answers 403 when it isn't "true".
ALLOW_DEV_ROUTES="true"

# Twilio (or alternative) — not wired yet, OTPs are logged to the console
# in dev. See Afaireplustard.txt.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# NoSMSNow (nosmsnow/) — optional. When set, SMS/OTP/email console senders
# also forward to it so sends show up in that terminal too. Leave unset to
# just log to this process's own console, no NoSMSNow required.
# NOSMSNOW_URL="http://localhost:4001"

# Feedback inbox: the account that receives every Give feedback message
# (an ordinary account; `npm run seed:dev` creates this demo one). Unset =
# the feedback page isn't available.
SUPPORT_EMAIL="support@testmsc.ch"
