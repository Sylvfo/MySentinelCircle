# Local dev placeholder — replace with your Neon connection string
# (Neon dashboard -> Connection Details -> Prisma-formatted string).
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/mysentinelcircle?sslmode=require"

JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="30d"

# Google Cloud Console -> OAuth 2.0 Client (Web application). Only the
# client ID is needed server-side (ID token audience check) — see
# Afaireplustard.txt.
GOOGLE_CLIENT_ID=""

# Twilio (or alternative) — not wired yet, OTPs are logged to the console
# in dev. See Afaireplustard.txt.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
