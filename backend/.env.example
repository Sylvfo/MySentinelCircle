# MariaDB running via docker-compose (root docker-compose.yml). Values must
# match MARIADB_USER/MARIADB_PASSWORD/MARIADB_DATABASE in the root .env.
# Backend runs on the host, so it reaches the DB via the published port.
DATABASE_URL="mysql://<MARIADB_USER>:<MARIADB_PASSWORD>@localhost:3306/<MARIADB_DATABASE>"

JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="30d"

# Google Cloud Console -> OAuth 2.0 Client (Web application). Only the
# client ID is needed server-side (ID token audience check) — see
# Afaireplustard.txt.
GOOGLE_CLIENT_ID=""

# Twilio (or alternative) — not wired yet, OTPs are logged to the console
# in dev. See Afaireplustard.txt.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
