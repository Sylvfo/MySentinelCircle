// A chat thread scoped to one alert. `circle` is the 1st circle's own
// group chat (one per alert). `sentinel_plus` is one per Sentinel+ who
// requests to talk (sentinelContactId identifies which one — several can
// coexist per alert, each isolated). `organization` opens automatically
// for Organization-raised alerts, at most one per alert.
model AlertChat {
  id      String        @id @default(cuid())
  alertId String
  alert   Alert         @relation(fields: [alertId], references: [id])
  type    AlertChatType

  sentinelContactId String?
  sentinelContact   Contact? @relation("AlertChatSentinelContact", fields: [sentinelContactId], references: [id])

  createdAt DateTime @default(now())

  messages Message[]
}

// Full message log. Tied either to a specific AlertChat (in-alert
