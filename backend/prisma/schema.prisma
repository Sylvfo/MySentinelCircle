//snapshop imuable pris au moment de l'alerte. Copie les infos.
// c'est les infos sur chaque sentinelle pendant l'alerte X. Sera stockée pour history
model LinkAlert {
    id String   @id @default(cuid()) //clé primaire
    createdAt   DateTime @default(now())
    updatedAt   DateTime  @updatedAt


    alerteId String
    sentinelId String

    sentinel User @relation("SentinelToAlert",fields: [sentinelId], references: [id])
    alerte Alert @relation("AlertToSentinel", fields: [alerteId], references: [id])

        //copier les données
    //concerné comme sentinel ou companion=
    //sentinels infos
    //cercles
    //droits

}

model LinkSentinels{
    id String   @id @default(cuid()) //clé primaire
    createdAt   DateTime @default(now())
    updatedAt   DateTime  @updatedAt

    isLeadSentinel Boolean @default(false)

    //fk forein key
//    companionId   String //pk pas user
    sentinelId    String   
    circleId      String
    requestById   String

//  companion User @relation("CompanionLinks", fields: [companionId], references: [id])

  sentinels User @relation("LinksToSentinels",fields: [sentinelId], references: [id])

 companions User @relation("LinksToCompanions",fields: [sentinelId], references: [id])

  requestBy User @relation("RequestedLinks",fields: [requestById],references: [id])

  circle Circle @relation(fields: [circleId],references: [id])

    @@unique([sentinelId, circleId])

//    Chat            messages?

    status      LinkStatus
    isLead      Boolean  @default(false)
    is1Circle   Boolean  @default(false)

    CurrentAlert    String?
//    HistoryAlert    Alert[]

//  permissions
    //messages permissons
