// En résumé : PK Primary Key= "je suis identifié par ça", 
// FK Foreign Key    = "je pointe vers l'identifiant de quelqu'un d'autre".
// @unique = UK = Unique Key


//Many-to-many = jamais de FK directe, 
//toujours une table de liaison avec ses propres FK des deux côtés.

//LinkSentinels = état actuel (vivant, modifiable) 
//de qui est sentinel de qui, dans quel circle.


//LinkAlert = copie figée au moment de l'alerte (userId, circleId, 
//rôle, statut de notification) — indépendante de LinkSentinels, pour ne jamais 
//être faussée si le lien vivant change après coup.


//companion reste une FK directe sur Alert (cardinalité 1, pas besoin de table de liaison).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SentinelType {
  ONLY_SMS
  SENTINEL
  LEAD
  FIRSTCIRCLE
  UNCOMPLETE//?
}

enum SentinelStatus {
    INACTIVE
    ACTIVE
    CONNECTED
    DEAD
}

enum UserType {
    ONLY_SMS   
    ACCOUNT
    PAID_ACCOUNT
    ORGANISATION
    DEAD
}

enum LinkStatus {
  PENDING
  ACCEPTED
  DECLINED
  REMOVED//UTILE?
  BLOCKED
}

enum AlertStatus {
  SENT
  LAUCHED
  ACTIVE
  CLOSING
  RESOLVED
}

enum AlertType {
  MISSING
  INCIDENT
  UNKNOWN
}

enum CircleType { 
  BASIC
  FIRST
  ORGANISATION
  EMPTY
  CLOSED
}

enum EmergencyType {
    LITTLEWORRY //find better word :)
    ACCIDENT
    EMERGENCY
}

enum LeadSlot {
  LEAD_1
  LEAD_2
  LEAD_3
}


//HORS ALERTE
//Tout va être construit avec user, linkSentinel et Circle. C'est la base de donnée que le USer construit
// messagerie entre Companion et ses sentinelles. + status

// DURANT ALERTE
//Quand une alerte va être déclanchée, ça va copier les liens entre les sentinelles et les circles...
// disons ça copie les cerces et les sentinelles. A la fin de l'alerte, ça supprime les cercles et sentinelles non solicitées. 
// ça va travailler dessus et garder un historique
// Les messageries seront là. 

// le compagnon peut envoyer des alertes??

//Durée du vie d'une alerte?
// Info A avoir si on veut pouvoir utiliser

// ENTITY User/ Circle/ Alerte/
model User {
  // IDENTITY
  id              String    @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime  @updatedAt

  //info users
  firstName       String
  lastName        String?
  userName        String?   @unique
  email           String?   @unique
  passwordHash    String?
  googleId        String?   @unique
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  isMajor         Boolean @default(true)
  status          String?
  //photo

  //as customer
  usertype        UserType? @default(ONLY_SMS)// ou only sms?
  hasPaid         Boolean @default(false)
  confirmedByOwner  Boolean @default(false)

// à voir....
  // OTP verification (signup completion + phone-based login). Single slot
  // per user — a new request overwrites the previous code.
  otpCodeHash  String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)

    //messagerie

  // LINKS
  // As companion
  myCircles Circle[] @relation("MyCirclesAsCompanion") //->mySentinels

  myAlertes Alert [] @relation("MyAlertsAsCompanion")

  mySentinels LinkSentinels[] @relation("SentinelCompanion")

  // As sentinel
  LinkAsSentinel LinkSentinels[] @relation("LinkAsSentinel")
  sentinelAlerts LinkSentinelAlert[] @relation("SentinelAlerts")///????

  // Invitations / demandes créées par ce user A  voir
  requestedLinks LinkSentinels[] @relation("RequestedLinks")
}

//ici le plus d'info
model LinkSentinels{
  // IDENTITY
    id String   @id @default(cuid()) //clé primaire
    createdAt   DateTime @default(now())
    updatedAt   DateTime  @updatedAt
    sentinelType SentinelType @default(ONLY_SMS)

    status      LinkStatus @default(PENDING)
//    isLead      Boolean  @default(false)//should accept
    requestedAsLead Boolean  @default(false)
    is1Circle   Boolean  @default(false)
    leadSlot LeadSlot?

  //permissions
  GroupChat     Boolean @default(false)
  Chat          Boolean @default(false)
  CanSendPhone          Boolean @default(false)

  // LINKS
  sentinelId    String
  companionId   String
  circleId      String
  requestById   String

  circle Circle @relation(fields: [circleId, companionId],references: [id, companionId])
  LinkAsSentinel User @relation("LinkAsSentinel",fields: [sentinelId], references: [id])
  requestBy User @relation("RequestedLinks",fields: [requestById],references: [id])//???
  companion User @relation("SentinelCompanion", fields: [companionId], references: [id])

  // sentinel in only one circle
   @@unique([sentinelId, companionId])
   @@unique([circleId, leadSlot])
}


model Circle {
  // IDENTITY
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt
  closedAt DateTime?

  label     String
  Status    String?
  circleType CircleType @default(BASIC)

  //DATA
  GroupChat     Boolean @default(false)
  CanSendPhone  Boolean @default(false)
  // LINKS
  companionId   String
  companion     User     @relation("MyCirclesAsCompanion", fields: [companionId], references: [id])

  sentinelLinks LinkSentinels[]

  //cercle, companion
  @@unique([id, companionId])
}


////////////////////////////////////////////////////////////////////
///// ALERTES

model Alert {
  // IDENTITY
  id     String      @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime?  @updatedAt
  closedAt DateTime?
  label String //trouver 1 string par defaut à mettre dans 
  emergencyType EmergencyType @default(LITTLEWORRY)

  // DATA
  sentBy        String
  leadBy        String?
  closedBy      String?
  messageAlert  String
  alertStatus   AlertStatus @default(SENT)//???
  alertType     AlertType @default(UNKNOWN)

  firstCircleId String
  leadSentinel  String? //a determiner durant alerte

  StatusByCompanion String?
  StatusByFirstCircle String?
  // LINKS
  //companion
  companionId   String
  companion     User     @relation("MyAlertsAsCompanion", fields: [companionId], references: [id])

  //circles
  Mycircles CircleAlert [] @relation("MyCirclesduringAlerte")
}

//copy data from circles, use it, at the end delete data non-used (all circles, sentinelle not contacted), store it as history

// peu d'info à part les droits et les conversation
model CircleAlert {
  // IDENTITY
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime?  @updatedAt
  closedAt DateTime?

  //DATA COPIED FROM CIRCLE
  label     String
  isPrimary Boolean  @default(false)//PRENDS QUE BASIC ET FIRST
  //  Status    String?

  //Permissions
  GroupChat     Boolean @default(false)  
  CanSendPhone          Boolean @default(false)

  //DATA
  //CHAT FIRST CIRCLE
  //CHAT OWN CIRCLE
  //SMS ANSWERS
  //APP ANSWERS

  wasContacted Boolean  @default(false)
  contactedAt DateTime?

  //snap shot cercle de base, mais pas de liens car le cercle peut être modifié plus tard
  sourceCircleId String
  @@index([sourceCircleId])
  companionId   String
  @@index([companionId])


  // LINKS
  alertId   String
  alert     Alert     @relation("MyCirclesduringAlerte", fields: [alertId], references: [id])

  sentinels LinkSentinelAlert[]
  // on peut copier le cercle 1 seule fois
  @@unique([alertId, sourceCircleId])
  @@unique([id, alertId])

}

//liens entre chaque sentinelle et l alerte
model LinkSentinelAlert {
  // IDENTITY
  id String   @id @default(cuid()) //clé primaire
  createdAt DateTime @default(now())
  updatedAt DateTime?  @updatedAt
  closedAt DateTime?


  //DATA COPIED FROM USER SENTINEL
    FirstName String
  lastName        String?
  userName        String?
  email           String
  phone           String

  phoneVerifiedAt DateTime?
  isMajor         Boolean @default(true)// a voir
  status          String?
  //photo

  //DATA COPIED FROM LINK SENTINEL
    isPending Boolean 
    sentinelType SentinelType
    is1Circle   Boolean
    leadSlot LeadSlot?

  //permissions
  GroupChat     Boolean @default(false)
  Chat          Boolean @default(false)
  CanSendPhone          Boolean @default(false)


  // DATA DURING ALERT
  sentinelStatus SentinelStatus @default(INACTIVE)
  contacted Boolean @default(false)
  contactedAt  DateTime?
  contactedBy String?
  contactedWhy String?

  //CHAT 1 CIRCLE
  //SMS ANSWERS
  //APP ANSWERS

  // LINKS

  // snap shots le liens peut changer ou disparaitre
  sourceLinkSentinelsId String

  @@index([sourceLinkSentinelsId])

  alertId          String
  alertsentinelId    String
  circleAlertId      String

  circle CircleAlert @relation(fields: [circleAlertId, alertId],references: [id, alertId])
  LinkAsAlertSentinel User @relation("SentinelAlerts",fields: [alertsentinelId], references: [id])

  // pour qu une sentinelle soit pas copiée 2 fois la même alerte
  @@unique([alertId, alertsentinelId])
}



