generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserType {
  ONLY_SMS
  ACCOUNT
  ORGANISATION
  UNCOMPLETE
}

enum UserStatus {
  ACTIVE
  //PAUSED
  DELETED
  DECEASED
}

enum SentinelType {
  ONLY_SMS
  SENTINEL
  LEAD
  FIRSTCIRCLE
  UNCOMPLETE
}

enum LinkInitiator {
  COMPANION
  SENTINEL
}

enum LinkStatus {
  PENDING
  ACCEPTED
  DECLINED
  REMOVED
  BLOCKED
}

enum CircleType {
  BASIC
  FIRST
  ORGANISATION
  RESERVED
  GROUP
}

enum CircleStatus {
  ACTIVE
  CLOSED
}

enum LeadSlot {
  LEAD_1
  LEAD_2
  LEAD_3
}

/*
enum MessagingMode {
  NONE
  INDIVIDUAL
  GROUP
}*/

enum AlertStatus {
  SENT
  LAUNCHED
  ACTIVE
  CLOSING
  RESOLVED
}

enum AlertType {
  BYCOMPANION
  LITTLEWORRY
  MISSING
  INCIDENT
  UNKNOWN
  EMERGENCY
  NOCONTACT
  TRAVEL
}

enum AlertParticipantStatus {
  WAITING
  CONTACTED
  RESPONDED
  ACTIVE
  DECLINED
  UNAVAILABLE
  CLOSED
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum NotificationType {
  ALERT_RAISED
  ALERT_ESCALATED
  ALERT_RESPONSE
  ALERT_CLOSED
  ALERT_CIRCLE_NO_RESPONSE
  ALERT_LEAD_CLAIMED
  SENTINEL_GROUP_INVITED
  NEW_MESSAGE
  SENTINEL_INVITATION_RECEIVED
  SENTINEL_REQUEST_RECEIVED
  SENTINEL_LINK_ANSWERED
  DEATH_NOTICE_REPORTED
  DEATH_NOTICE_CONFIRMED
  DEATH_NOTICE_REJECTED
  SENTINEL_LEFT
  CIRCLE_MOVE_PROPOSED
  CIRCLE_MOVE_ANSWERED
  SENTINEL_TO_RESERVE
}

enum Gender {
  FEMALE
  MALE
  NEUTRAL
}

enum LoginMethod {
  EMAIL_PASSWORD
  PHONE_PASSWORD
  GOOGLE
  SMS_CODE
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status    UserStatus @default(ACTIVE)
  deletedAt DateTime?

  firstName    String
  lastName     String?
  userName     String? @unique
  email        String? @unique
  passwordHash String?
  loginAttempts    Int       @default(0)
  loginLockedUntil DateTime?
  lastLoginAt      DateTime?
  // "Sign me out everywhere": any login token issued before this is refused.
  sessionsValidAfter DateTime?
  language            String?  @db.VarChar(5)
  alertContactSharing Boolean  @default(false)
  gender Gender? // how texts speak about me; null = inclusive wording
  phoneRecoveryRequestedAt   DateTime?
  phoneRecoveryConfirmedById String?

  googleId     String? @unique
  avatarPath String?
  stepUpVerifiedAt        DateTime?
  pendingEmail             String?
  pendingEmailTokenHash    String?   @unique
  pendingEmailExpiresAt    DateTime?  
  //allowMessagingByDefault Boolean @default(true) // companion-wide fallback
  alertChatWithFirstCircle Boolean @default(true) // master switch: if false, no Sentinel of mine may chat with my 1st circle during an alert
  pausedForMe     Boolean @default(false) // nobody else may raise an alert about me
  pausedForOthers Boolean @default(false) // I can't be asked to take part in any alert
  
  phone           String? @unique
  phoneVerifiedAt DateTime?
  pendingPhone String?

  isMajor      Boolean @default(true)
  publicStatus String? @db.VarChar(200)

  userType         UserType @default(ONLY_SMS)
 //hasPaid          Boolean  @default(false)
  confirmedByOwner Boolean  @default(false)
  paidUntil              DateTime? // yearly subscription: active while in the future (replaces hasPaid)
  deathNoticePurchasedAt DateTime? // one-time purchase of the death notice (without a subscription)
  alertsPaid             Alert[]   @relation("AlertPaidBy")

  otpCodeHash  String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  
  passwordResetTokenHash  String?   @unique
  passwordResetExpiresAt  DateTime?

  deceasedAt DateTime?
  deathAnnouncementMessage String?  @db.Text

  myCircles   Circle[]        @relation("MyCirclesAsCompanion")
  myUserSentinels LinkSentinels[] @relation("SentinelCompanion")
  myAlerts    Alert[]         @relation("MyAlertsAsCompanion")

  linksAsSentinel LinkSentinels[] @relation("LinkAsSentinel")

  alertQuestionsAsked AlertQuestion[] @relation("AlertQuestionAskedBy")


  launchedAlerts Alert[]      @relation("AlertLaunchedBy")
  closedAlerts   Alert[]      @relation("AlertClosedBy")
  requestedAlertParticipations AlertParticipant[] @relation("AlertParticipantRequestedBy")
  statusUpdatedAlerts          Alert[]            @relation("AlertStatusUpdatedBy")
  labelUpdatedAlerts           Alert[]            @relation("AlertLabelUpdatedBy")

  loginEvents        LoginEvent[]


  notifications      Notification[] @relation("NotificationRecipient")
  actorNotifications Notification[] @relation("NotificationActor")
  groupInvitationsReceived SentinelGroupInvitation[] @relation("GroupInvited")
  groupInvitationsSent     SentinelGroupInvitation[] @relation("GroupInviter")

  conversationMemberships ConversationParticipant[]
  sentMessages            Message[]

  termsAcceptedAt DateTime? // when the person accepted the terms + privacy policy
  termsVersion    String?   // which version they accepted, e.g. "2026-11"

  deathReportedAt    DateTime?      // NEW — set when a Lead reports; cleared back to null on reject
  deathReportedById  String?        // NEW
  deathReportedBy    User?          @relation("DeathReportedBy", fields: [deathReportedById], references: [id], onDelete: Restrict)  // NEW
  deathReportsFiled  User[]         @relation("DeathReportedBy")  // NEW — reverse side of the self-relation

  deathConfirmedById    String?     // NEW
  deathConfirmedBy      User?       @relation("DeathConfirmedBy", fields: [deathConfirmedById], references: [id], onDelete: Restrict)  // NEW
  deathConfirmationsMade User[]     @relation("DeathConfirmedBy")  // NEW — reverse side

}

model Circle {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  label      String
  circleType CircleType   @default(BASIC)
  status     CircleStatus @default(ACTIVE)

  //canMessageMe Boolean? // whole circle may chat with the 1st circle during an alert, if the User switch allows it; ignored for circleType FIRST
  alertChatWithFirstCircle Boolean @default(true) // whole circle may chat with the 1st circle during an alert, if the User switch allows it; ignored for circleType FIRST

  userCompanionId String
  userCompanion   User   @relation("MyCirclesAsCompanion", fields: [userCompanionId], references: [id], onDelete: Restrict)

  userSentinels       LinkSentinels[]
  alertsAsFirstCircle Alert[]            @relation("AlertFirstCircle")
  alertParticipations AlertParticipant[]
  groupRootId  String?
  groupRoot    Circle?  @relation("GroupMembers", fields: [groupRootId], references: [id], onDelete: Restrict)
  groupMembers Circle[] @relation("GroupMembers")
  groupInvitations SentinelGroupInvitation[]


  @@unique([userCompanionId, groupRootId])
  @@unique([id, userCompanionId])
  @@index([userCompanionId, status])
}

model LinkSentinels {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status      LinkStatus    @default(PENDING)
  initiatedBy LinkInitiator
  //canMessageMe Boolean? // null = inherit the circle's setting (which inherits the companion's default) — highest priority, most specific wins

  sentinelType    SentinelType @default(ONLY_SMS)
  requestedAsLead Boolean      @default(false)
  leadSlot        LeadSlot?

  //canMessageOwnCircle      Boolean       @default(true)
  //firstCircleMessagingMode MessagingMode @default(NONE)
  canSendPhone             Boolean       @default(false)

  userSentinelId  String
  userCompanionId String
  circleId    String
  proposedCircleId String?   // set only while awaiting consent to move into the 1st circle
  callOrder Int? // manual outer-circle call rank (lower = called first); null = random fallback

  linkAsSentinel User   @relation("LinkAsSentinel", fields: [userSentinelId], references: [id], onDelete: Restrict)
  userCompanion      User   @relation("SentinelCompanion", fields: [userCompanionId], references: [id], onDelete: Restrict)
  circle         Circle @relation(fields: [circleId, userCompanionId], references: [id, userCompanionId], onDelete: Restrict)
  notifyOnDeath        Boolean    @default(false)  // NEW — opted in by the companion as a death-notice recipient
  deathPersonalMessage String?    @db.Text         
  deathNotifiedAt      DateTime?                     
  events              LinkSentinelsEvent[]
  alertParticipations AlertParticipant[]

  @@unique([userSentinelId, userCompanionId])
  @@unique([circleId, leadSlot])
  @@index([userCompanionId, status])
}

model SentinelGroupInvitation {
  id            String     @id @default(cuid())
  createdAt     DateTime   @default(now())
  groupRootId   String
  groupRoot     Circle     @relation(fields: [groupRootId], references: [id], onDelete: Restrict)
  invitedUserId String
  invitedUser   User       @relation("GroupInvited", fields: [invitedUserId], references: [id], onDelete: Restrict)
  invitedById   String
  invitedBy     User       @relation("GroupInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  status        LinkStatus @default(PENDING)

  @@unique([groupRootId, invitedUserId])
}

model LinkSentinelsEvent {
  id              String        @id @default(cuid())
  userSentinelsId String
  userSentinels   LinkSentinels @relation(fields: [userSentinelsId], references: [id], onDelete: Restrict)

  fromStatus LinkStatus?
  toStatus   LinkStatus
  occurredAt DateTime    @default(now())

  @@index([userSentinelsId, occurredAt])
}

model Alert {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  launchedAt  DateTime?
  activatedAt DateTime?
  closingAt   DateTime?
  closedAt    DateTime?

  label        String
  messageAlert String  @db.Text
  alertStatus  AlertStatus @default(SENT)
  alertType    AlertType   @default(UNKNOWN)

  paidById String? // who paid for this single alert (outside any subscription)
  paidBy   User?   @relation("AlertPaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  statusByCompanion   String?  @db.VarChar(500)
  statusByFirstCircle String?  @db.VarChar(500)
  statusUpdatedById String?
  statusUpdatedBy   User?     @relation("AlertStatusUpdatedBy", fields: [statusUpdatedById], references: [id], onDelete: Restrict)
  statusUpdatedAt   DateTime?

  labelUpdatedById String?
  labelUpdatedBy   User?     @relation("AlertLabelUpdatedBy", fields: [labelUpdatedById], references: [id], onDelete: Restrict)
  labelUpdatedAt   DateTime?

  userCompanionId String
  userCompanion   User @relation("MyAlertsAsCompanion", fields: [userCompanionId], references: [id], onDelete: Restrict)

  firstCircleId String
  firstCircle   Circle @relation("AlertFirstCircle", fields: [firstCircleId], references: [id], onDelete: Restrict)

  launchedById String?
  launchedBy   User?   @relation("AlertLaunchedBy", fields: [launchedById], references: [id], onDelete: Restrict)

  closedById String?
  closedBy   User?   @relation("AlertClosedBy", fields: [closedById], references: [id], onDelete: Restrict)

  participants  AlertParticipant[]
  conversations Conversation[]

  @@index([userCompanionId, createdAt])
  @@index([alertStatus])
}

model AlertParticipant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status AlertParticipantStatus @default(WAITING)

  requestedById String?
  requestedBy   User?   @relation("AlertParticipantRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  contactedAt DateTime?
  answeredAt  DateTime?
  closedAt    DateTime?
  response    String?

  isLead         Boolean   @default(false)
// Repurposed as "when this Lead last claimed active leadership of the
// alert" (see AlertService.claimLead) — not just a contact-time freeze.
  leadAssignedAt DateTime?
  circleId       String
  circle         Circle    @relation(fields: [circleId], references: [id], onDelete: Restrict)
  circleName     String

  alertChatWithFirstCircleAtAlert Boolean? // frozen when the circle is solicited, so a later settings change doesn't alter a past alert

  canSendPhoneAtAlert             Boolean?
  //canMessageOwnCircleAtAlert      Boolean?
  //firstCircleMessagingModeAtAlert MessagingMode?
  //question String? @db.Text // the 1st circle's question when this circle was asked (requestCircle)

  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Restrict)
  questions AlertQuestion[]

  userSentinelsId String
  userSentinels   LinkSentinels @relation(fields: [userSentinelsId], references: [id], onDelete: Restrict)

  @@unique([alertId, userSentinelsId])
  @@index([alertId, status])
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  alertId String?
  alert   Alert?  @relation(fields: [alertId], references: [id], onDelete: Restrict)

  participants ConversationParticipant[]
  messages     Message[]

  @@index([alertId])
}

model ConversationParticipant {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([conversationId, userId])
}

model Message {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  //editedAt  DateTime?
  deletedAt DateTime?

  body String @db.Text
  type MessageType @default(TEXT)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  readAt    DateTime?

  type NotificationType

  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Restrict)

  actorUserId String?
  actor       User?   @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorLabel  String?

  accepted Boolean?

  targetId String?

  @@index([userId, readAt, createdAt])
}

// One question sent to one participant during an alert.
model AlertQuestion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kind       String    // CAN_VISIT, LAST_NEWS, SEEMED_OK or WHERE_SEEN
  response   String?   @db.VarChar(300) // reply code, or free text for WHERE_SEEN
  answeredAt DateTime?

  askedById String
  askedBy   User   @relation("AlertQuestionAskedBy", fields: [askedById], references: [id], onDelete: Restrict)

  alertParticipantId String
  alertParticipant   AlertParticipant @relation(fields: [alertParticipantId], references: [id], onDelete: Restrict)

  @@index([alertParticipantId, createdAt])
}

// One line per sign-in attempt on an account, success or failure: shown to
// the person in their Settings and counted on the admin page. Kept 90 days
// (RetentionService). The IP is stored cut short (its last part removed).
model LoginEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  method    LoginMethod
  success   Boolean
  ipPrefix  String? @db.VarChar(64)
  userAgent String? @db.VarChar(255)

  @@index([userId, createdAt])
  @@index([createdAt])
}

