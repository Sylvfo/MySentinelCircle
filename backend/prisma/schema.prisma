generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  ONLY_SMS
  ACCOUNT
  PAID_ACCOUNT
  ORGANISATION
}

enum UserStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum SentinelType {
  ONLY_SMS
  SENTINEL
  LEAD
  FIRSTCIRCLE
  UNCOMPLETE
}

enum LinkInitiator {
  COMPANION
  SENTINEL
}

enum LinkStatus {
  PENDING
  ACCEPTED
  DECLINED
  REMOVED
  BLOCKED
}

enum CircleType {
  BASIC
  FIRST
  ORGANISATION
}

enum CircleStatus {
  ACTIVE
  CLOSED
}

enum LeadSlot {
  LEAD_1
  LEAD_2
  LEAD_3
}

enum AlertStatus {
  SENT
  LAUNCHED
  ACTIVE
  CLOSING
  RESOLVED
}

enum AlertType {
  BYCOMPANION
  LITTLEWORRY
  MISSING
  INCIDENT
  UNKNOWN
  EMERGENCY
  NOCONTACT
}

enum AlertParticipantStatus {
  WAITING
  CONTACTED
  RESPONDED
  ACTIVE
  DECLINED
  UNAVAILABLE
  CLOSED
}

enum ConversationType {
  DIRECT
  FIRST_CIRCLE_GROUP
  CIRCLE_TO_CIRCLE
  FIRST_CIRCLE_SENTINEL
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum AlertEventType {
  ALERT_LAUNCHED
  STATUS_CHANGED
  SENTINEL_CONTACTED
  SENTINEL_RESPONDED
  LEAD_ASSIGNED
  PARTICIPANT_JOINED
  PARTICIPANT_LEFT
  CONVERSATION_OPENED
  ALERT_CLOSED
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status    UserStatus @default(ACTIVE)
  deletedAt DateTime?

  firstName    String
  lastName     String?
  userName     String? @unique
  email        String? @unique
  passwordHash String?
  googleId     String? @unique

  phone           String? @unique
  phoneVerifiedAt DateTime?

  isMajor      Boolean @default(true)
  publicStatus String?

  userType         UserType @default(ONLY_SMS)
  hasPaid          Boolean  @default(false)
  confirmedByOwner Boolean  @default(false)

  otpCodeHash  String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)

  myCircles   Circle[]        @relation("MyCirclesAsCompanion")
  mySentinels LinkSentinels[] @relation("SentinelCompanion")
  myAlerts    Alert[]         @relation("MyAlertsAsCompanion")

  linksAsSentinel LinkSentinels[] @relation("LinkAsSentinel")

  launchedAlerts Alert[]      @relation("AlertLaunchedBy")
  closedAlerts   Alert[]      @relation("AlertClosedBy")
  alertEvents    AlertEvent[] @relation("AlertEventActor")

  conversationMemberships ConversationParticipant[]
  sentMessages            Message[]
}

model Circle {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  label      String
  circleType CircleType   @default(BASIC)
  status     CircleStatus @default(ACTIVE)

  groupChat    Boolean @default(false)
  canSendPhone Boolean @default(false)

  companionId String
  companion   User   @relation("MyCirclesAsCompanion", fields: [companionId], references: [id], onDelete: Restrict)

  sentinelLinks       LinkSentinels[]
  alertsAsFirstCircle Alert[]         @relation("AlertFirstCircle")
  alertParticipations AlertParticipant[]

  @@unique([id, companionId])
  @@index([companionId, status])
}

model LinkSentinels {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status      LinkStatus    @default(PENDING)
  initiatedBy LinkInitiator

  sentinelType    SentinelType @default(ONLY_SMS)
  requestedAsLead Boolean      @default(false)
  leadSlot        LeadSlot?

  groupChat    Boolean @default(false)
  chat         Boolean @default(false)
  canSendPhone Boolean @default(false)

  sentinelId  String
  companionId String
  circleId    String

  linkAsSentinel User   @relation("LinkAsSentinel", fields: [sentinelId], references: [id], onDelete: Restrict)
  companion      User   @relation("SentinelCompanion", fields: [companionId], references: [id], onDelete: Restrict)
  circle         Circle @relation(fields: [circleId, companionId], references: [id, companionId], onDelete: Restrict)

  events              LinkSentinelsEvent[]
  alertParticipations AlertParticipant[]
  conversation        Conversation?

  @@unique([sentinelId, companionId])
  @@unique([circleId, leadSlot])
  @@index([companionId, status])
}

model LinkSentinelsEvent {
  id              String        @id @default(cuid())
  linkSentinelsId String
  linkSentinels   LinkSentinels @relation(fields: [linkSentinelsId], references: [id], onDelete: Restrict)

  fromStatus LinkStatus?
  toStatus   LinkStatus
  occurredAt DateTime    @default(now())

  @@index([linkSentinelsId, occurredAt])
}

model Alert {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  label        String
  messageAlert String
  alertStatus  AlertStatus @default(SENT)
  alertType    AlertType   @default(UNKNOWN)

  statusByCompanion   String?
  statusByFirstCircle String?

  companionId String
  companion   User @relation("MyAlertsAsCompanion", fields: [companionId], references: [id], onDelete: Restrict)

  firstCircleId String
  firstCircle   Circle @relation("AlertFirstCircle", fields: [firstCircleId], references: [id], onDelete: Restrict)

  launchedById String?
  launchedBy   User?   @relation("AlertLaunchedBy", fields: [launchedById], references: [id], onDelete: Restrict)

  closedById String?
  closedBy   User?   @relation("AlertClosedBy", fields: [closedById], references: [id], onDelete: Restrict)

  participants  AlertParticipant[]
  conversations Conversation[]
  events        AlertEvent[]

  @@index([companionId, createdAt])
  @@index([alertStatus])
}

model AlertParticipant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status AlertParticipantStatus @default(WAITING)

  contactedAt DateTime?
  answeredAt  DateTime?
  closedAt    DateTime?
  response    String?

  isLead         Boolean   @default(false)
  leadAssignedAt DateTime?
  circleId   String
  circle     Circle @relation(fields: [circleId], references: [id], onDelete: Restrict)
  circleName String

  canSendPhoneAtAlert Boolean?
  chatAtAlert         Boolean?
  groupChatAtAlert    Boolean?

  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Restrict)

  linkSentinelsId String
  linkSentinels   LinkSentinels @relation(fields: [linkSentinelsId], references: [id], onDelete: Restrict)

  privateConversation Conversation?
  events              AlertEvent[]

  @@unique([alertId, linkSentinelsId])
  @@index([alertId, status])
}

model AlertEvent {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  type      AlertEventType
  data      Json?

  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Restrict)

  actorId String?
  actor   User?   @relation("AlertEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  participantId String?
  participant   AlertParticipant? @relation(fields: [participantId], references: [id], onDelete: Restrict)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([alertId, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  type ConversationType

  linkSentinelsId String?        @unique
  linkSentinels   LinkSentinels? @relation(fields: [linkSentinelsId], references: [id], onDelete: Restrict)

  alertId String?
  alert   Alert?  @relation(fields: [alertId], references: [id], onDelete: Restrict)

  alertParticipantId String?           @unique
  alertParticipant   AlertParticipant? @relation(fields: [alertParticipantId], references: [id], onDelete: Restrict)

  participants ConversationParticipant[]
  messages     Message[]
  events       AlertEvent[]

  @@index([alertId])
}

model ConversationParticipant {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([conversationId, userId])
}

model Message {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  body String
  type MessageType @default(TEXT)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
}
